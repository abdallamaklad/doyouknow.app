# doyouknow.app — environment variables
#
# Copy to `.env` for local runs and export these in the shell (or the systemd
# unit) before running the scripts that need them. `.env` itself must never be
# committed — these are all live credentials.

# --- GA4 (analytics) ---------------------------------------------------------
# Measurement ID of the doyouknow.app web stream. Not a secret — it is already
# public in every page's gtag snippet — but the server-side sender reads it from
# here so the ID lives in one place.
GA4_MEASUREMENT_ID=G-6VQZY87LJB

# Measurement Protocol API secret (GA4 Admin → Data Streams → Measurement
# Protocol API secrets). This IS a secret: it authorises writing events into the
# property. Leave blank here; set the real value only in the deployment
# environment. Without it, scripts/lib/ga4-mp.mjs logs a warning and sends nothing.
GA4_MP_API_SECRET=

# --- World Cup live stats ----------------------------------------------------
# API-Football key used by scripts/update-worldcup-stats.mjs and the
# worldcup-live-scheduler systemd unit.
APIFOOTBALL_KEY=
